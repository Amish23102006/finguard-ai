{
  "name": "FinGuard AI (Python 3.11)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install -e '.[dev]' && cp -n .env.example .env; .venv/bin/python -m finguard.models.train",
  "forwardPorts": [8000, 8501],
  "portsAttributes": {
    "8000": { "label": "FinGuard API" },
    "8501": { "label": "FinGuard Dashboard", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "settings": { "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python" },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "ms-azuretools.vscode-docker",
        "github.vscode-github-actions",
        "humao.rest-client"
      ]
    }
  }
}
